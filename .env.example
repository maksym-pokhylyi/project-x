# =============================================================================
# Environment variables
#
#   cp .env.example .env.local      # local development (git-ignored)
#
# Validated at startup by src/env.ts (the app refuses to boot with a readable
# message if something required is missing or malformed).
# Only DATABASE_URL and BETTER_AUTH_SECRET are required. Every integration below
# is optional and the app degrades gracefully without it.
# NEVER commit real values. In production set them in Vercel > Project > Settings
# > Environment Variables.
# =============================================================================

# --- Core (required) ----------------------------------------------------------

# PostgreSQL connection string.
# Local: the docker-compose database. Production: Neon's POOLED connection string
# (host contains "-pooler"); the app uses prepare:false so pooling works.
DATABASE_URL=postgres://app:app@localhost:5432/app_dev

# Optional. Neon's DIRECT (unpooled) connection string. When set, `pnpm db:migrate`
# uses it for schema changes; otherwise it falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Secret used to sign session cookies and file URLs. At least 32 characters.
# Generate:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Canonical public origin of this deployment, no trailing slash.
# Used for auth callbacks, e-mail links, metadata and CSRF origin checks.
# On Vercel it may be omitted (derived from the project's production domain), but
# setting it explicitly to your custom domain is recommended.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth ---------------------------------------------------------------------

# Optional Google sign-in. Both must be set to enable the button.
# https://console.cloud.google.com/apis/credentials  (OAuth client, type "Web application")
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated e-mail addresses allowed into /admin (the address must be verified).
ADMIN_EMAILS=
# Optional pin: user ids (comma-separated) that /admin additionally requires. Set it after
# your first sign-in:  select id from users where email = '<you>';
ADMIN_USER_IDS=
# Extra origins allowed to call the auth API, comma-separated (e.g. https://your-project.vercel.app
# while the custom domain is not live yet). The canonical NEXT_PUBLIC_APP_URL is always trusted.
AUTH_TRUSTED_ORIGINS=

# --- E-mail (Resend) ----------------------------------------------------------

# https://resend.com/api-keys — without it, e-mails are written to the email_outbox
# table and shown at /dev/outbox (development only). A PRODUCTION build that cannot deliver
# e-mail does not skip verification: sign-up, password reset and invitations are DISABLED
# until RESEND_API_KEY and EMAIL_FROM are both set.
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g.  "Bidfolio <no-reply@bidfolio.co.uk>"
# Required on the production deployment (there is no fallback sender there).
EMAIL_FROM=
# ESCAPE HATCH, pre-launch testing only. "1" = where e-mail cannot be delivered, accept
# sign-ups WITHOUT any verification (anyone can register any address). Logged loudly at
# start-up and shown on /admin; ignored once e-mail works. Never set it with real users.
ALLOW_UNVERIFIED_SIGNUP=

# --- Billing (Paddle Billing) -------------------------------------------------
# Without these the app still runs: pricing shows plans, checkout buttons show
# "Billing not configured", webhooks answer 503.

# sandbox | production  (use separate Paddle accounts/keys per environment)
# On the production deployment, "sandbox" switches billing OFF (see ALLOW_SANDBOX_BILLING).
PADDLE_ENV=sandbox
# ESCAPE HATCH, pre-launch testing only. "1" = allow Paddle SANDBOX on the production
# deployment: anyone with a Paddle test card gets a paid plan. Billing screens then show
# "Test mode — no real payments". Never set it with real users.
ALLOW_SANDBOX_BILLING=
# Optional. Signs the checkout custom data that ties a payment to a workspace (at least 32
# characters). Defaults to a key derived from BETTER_AUTH_SECRET.
# Generate:  openssl rand -base64 32
BILLING_SIGNING_SECRET=
# Paddle > Developer tools > Authentication > API keys (server-side, secret)
PADDLE_API_KEY=
# Paddle > Developer tools > Authentication > Client-side tokens (public by design)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Paddle > Developer tools > Notifications > (destination) > secret key
# Destination URL: <NEXT_PUBLIC_APP_URL>/api/webhooks/paddle
PADDLE_WEBHOOK_SECRET=
# Price ids. Run `pnpm paddle:setup` to create products/prices from
# src/config/plans.ts and print these lines.
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_ANNUAL=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_ANNUAL=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_ANNUAL=
# Days a past_due subscription keeps its paid plan before falling back to Free (default 7).
BILLING_PAST_DUE_GRACE_DAYS=7
# Fail-safe (default 3): days after the end of the paid period before an "active"
# subscription stops granting its plan when no renewal or cancellation reached us.
BILLING_PERIOD_END_GRACE_DAYS=3
# Max accepted age of a webhook signature timestamp, in seconds (default 300).
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300

# --- Background jobs ----------------------------------------------------------

# Shared secret for /api/cron/jobs. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>". At least 16 characters, letters/digits only.
# Generate:  openssl rand -hex 24
CRON_SECRET=

# --- Analytics & observability (optional) -------------------------------------

# PostHog project API key (public). Enables client page views + server event forwarding.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host: https://us.i.posthog.com (default) or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
# Sentry DSN. Server errors are forwarded in addition to the error_log table.
SENTRY_DSN=
# debug | info | warn | error  (default info)
LOG_LEVEL=info

# --- File storage (optional) --------------------------------------------------

# Vercel Blob read-write token of a PRIVATE store (Vercel > Storage > Blob).
# Without it files are stored on the local filesystem under ./.data (dev only:
# Vercel's filesystem is read-only/ephemeral, so set this before using uploads in production).
BLOB_READ_WRITE_TOKEN=

# --- AI (optional) ------------------------------------------------------------

# Vercel AI Gateway. On Vercel, authentication is automatic (OIDC) and nothing is
# needed. Locally use an API key (Vercel > AI Gateway > API keys) or run
# `vercel env pull` to obtain VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=
# Global ceiling for ESTIMATED AI spend per UTC day, in USD (default 10). 0 disables AI.
# A hard limit: every call reserves its worst-case cost before the provider is contacted.
AI_DAILY_BUDGET_USD=10
# Daily pool shared by ALL free-plan workspaces, in USD (default: 25% of the above), so
# free workspaces can never use up the budget paying customers draw from.
AI_FREE_DAILY_BUDGET_USD=

# --- Development tooling ------------------------------------------------------

# "1" enables /dev/outbox on a production BUILD (used by `pnpm e2e`).
# Ignored when VERCEL_ENV=production. Leave empty everywhere else.
DEV_TOOLS=
# With DEV_TOOLS=1 on a production build the outbox needs a founder session or this key:
# /dev/outbox?key=<DEV_TOOLS_SECRET>   (at least 16 characters)
DEV_TOOLS_SECRET=
# "1" = trust X-Forwarded-For / X-Real-IP when NOT on Vercel (self-hosting behind a reverse
# proxy that overwrites them). Without it all clients share one rate-limit bucket there.
TRUST_PROXY_HEADERS=
# "1" makes `pnpm db:migrate` a no-op.
SKIP_DB_MIGRATE=
# On Vercel, `pnpm db:migrate` only runs for PRODUCTION deployments. Set this to "1" in a
# Preview environment that has its OWN database (a Neon branch) to migrate it too.
# Never set it while Preview shares production's DATABASE_URL.
MIGRATE_PREVIEW_DATABASE=
