  },
  "title": "Planned Investment Works Framework",
  "description": "The Planned Investment Works Framework will deliver planned investment works to ML stock which consist of Houses, Bungalows, Flats and Extra Care Living Scheme.\nThe structure of the Framework is Lot specific and covers the following \n•\t1PI Energy Efficiency Measures - Lot value £1.66m (net)\n•\t2PI Roofing - Lot value £6.66m (net)\n•\t3PI Windows & Doors - Lot value £2.16m (net)\n•\t4P1Kitchens & Bathrooms - Lot value £26.66m (net)\n•\t5PI Electrical - Lot value £4.16m (net)\n•\t6PI Internal and External Paint and Repair - Lot value £5m (net)\n•\t7PI External Works (Groundworks, fencing, pointing etc.) - Lot value £2.5m (net)\n•\t8PI Heating - Domestic - Lot value £4.58m (net)\n•\t9PI Heating Commercial- Lot value £1.66m (net)\n•\t10PI Whole House Lot- Lot value £10m (net)",
  "status": "complete",
  "procurementMethod": "open",
  "procurementMethodDetails": "Open procedure",
  "participationFees": [
   {
    "type": [
     "win"
    ],
    "description": "No fee applies as Framework is for use by Magenta Living only.",
    "id": "ocds-h6vhtk-0518d5"
   }
  ],
  "techniques": {
   "hasFrameworkAgreement": true,
   "frameworkAgreement": {
    "method": "withAndWithoutReopeningCompetition",
    "type": "closed",
    "description": "Whenever Magenta Living wishes to call-off Works under the Framework those Works shall be allocated either through:\n•\tDirect Award to the top ranked provider where the in circumstance identified for Mini-Competition do not apply. If the topped ranked Provider on a specific Lot indicates they do not have the capacity to undertake the Works, the Order will be allocated to the next ranked provider and so on.\n•\tMini-Competition\n•\tthe Works need to be delivered within a shorter Target Completion Date than provided for in the Specification\n•\tthe nature of the Works means that there are specific health and safety risks that the Provider needs to manage when undertaking them which do not apply to other Works under this Framework\n•\tthere is an accurate quantified volume of Works and Magenta Living cannot determine which Service Provider will provide the best value\n•\twhere there are some minor additional works, services or rates which have not been originally assessed as part of the process for appointment to the Framework.\n•\twhere there are amendments to the requirements set out than those provided in the Specifications"
   }
  },
