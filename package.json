{
  "name": "saas-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx --import ./scripts/register-server-only.mjs scripts/seed.ts",
    "paddle:setup": "tsx scripts/paddle-setup.ts",
    "auth:schema": "pnpm dlx auth@latest generate --config scripts/auth-schema.config.ts --output src/db/schema/auth.ts --yes",
    "paddle:simulate": "tsx --import ./scripts/register-server-only.mjs scripts/simulate-webhook.ts"
  },
  "dependencies": {
    "@paddle/paddle-js": "1.6.6",
    "@paddle/paddle-node-sdk": "3.12.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.3.1",
    "@vercel/blob": "2.9.0",
    "@vercel/functions": "3.11.2",
    "ai": "7.0.172",
    "better-auth": "1.7.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "posthog-js": "1.448.0",
    "posthog-node": "5.73.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.38.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
